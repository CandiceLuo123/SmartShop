{
  "cases": [
    {
      "id": "logistics_stall_complaint",
      "scenario": "物流停滞投诉：查单+安抚+登记查件工单",
      "customer_id": "C003",
      "message": "我的订单SO2610180003，快递5天没动了！！你们怎么搞的，再不处理我就退货+投诉到底！",
      "expect": "先安抚情绪，查订单确认物流10-20后停滞，登记高优先级查件工单，承诺24小时内核实反馈（不得承诺具体到货时间）",
      "checks": {
        "expect_tools": ["query_order"],
        "expect_tools_any": [["create_ticket"]],
        "expect_keywords_any": [["查件", "核实", "反馈", "跟进"], ["抱歉", "理解", "不好意思", "安抚"]],
        "forbid_keywords": ["保证明天到", "24小时内送达"]
      }
    },
    {
      "id": "return_out_of_window",
      "scenario": "超出售后期限的退款要求：按政策拒绝+给替代方案",
      "customer_id": "C002",
      "message": "我9月买的充电宝，订单号SO2609090008，现在充不进电了，我要退款！",
      "expect": "查询订单确认签收2026-09-11（距今44天），超过15天质量包退换期：拒绝退款但给出保修期内免费维修方案（或优惠券安抚），不得承诺退款",
      "checks": {
        "expect_tools_any": [["query_order", "apply_after_sales"]],
        "expect_keywords_any": [["超过", "超出", "无法", "不能", "不在"], ["维修", "保修", "寄回", "优惠券", "补偿"]],
        "forbid_keywords": ["马上为您退款", "已为您提交退款", "全额退款已"]
      }
    },
    {
      "id": "quality_return_in_window",
      "scenario": "质量安全隐患（电池鼓包）：安全提醒+15天内包退换",
      "customer_id": "C002",
      "message": "订单SO2610150002里的充电宝好像鼓包了，有点害怕，怎么处理？",
