      "checks": {
        "expect_tools_any": [["apply_after_sales", "query_order", "create_ticket"]],
        "expect_keywords_any": [["停止使用", "立即停止", "不要再充", "远离", "安全"], ["退货", "换货", "退换", "工单", "登记", "售后"]],
        "forbid_keywords": []
